<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="GMS.Tools.TaggingPalette.TaggingPalettePane"
             Background="{DynamicResource PaletteBg}" FontFamily="Segoe UI Variable Text, Segoe UI" MinWidth="220" d:DesignHeight="520">

    <UserControl.Resources>
        <!-- Theme brushes — Color properties are swapped at runtime by ApplyTheme(); defaults are the
             light-theme gray values so the pane isn't off-palette before the first ApplyTheme. -->
        <SolidColorBrush x:Key="PaletteBg"          Color="#f9fafb"/>
        <SolidColorBrush x:Key="PaletteHeaderBg"    Color="#e5e8eb"/>
        <SolidColorBrush x:Key="PaletteHeaderText"  Color="#111b27"/>
        <SolidColorBrush x:Key="PaletteSubText"     Color="#374451"/>
        <SolidColorBrush x:Key="PaletteMutedText"   Color="#6f7985"/>
        <SolidColorBrush x:Key="TypeButtonBg"       Color="#e5e8eb"/>
        <SolidColorBrush x:Key="TypeButtonBgHover"  Color="#d1d6db"/>
        <SolidColorBrush x:Key="TypeButtonBgPress"  Color="#9ca5af"/>
        <SolidColorBrush x:Key="TypeButtonText"     Color="#111b27"/>

        <!-- Flat "chip" button — used for each tag/component type, and for the bottom-right
             Refresh button so both share the same look. Greys out (dimmed + arrow cursor, no
             hover/press feedback) when IsEnabled is false — see TaggingPaletteModule.ApplyEnablement,
             which disables a button when its category has nothing to tag in the active view. -->
        <Style x:Key="TypeChipButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource TypeButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TypeButtonText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TypeButtonBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TypeButtonBgPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section header bar (one per panel — Detail Item Tags / Unit / Piece Tags / Generic Models). -->
        <Style x:Key="SectionHeader" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PaletteHeaderBg}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- One family group: its name, then a wrapping row of type chips. -->
        <DataTemplate x:Key="FamilyGroupTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding FamilyName}"
                           Foreground="{DynamicResource PaletteSubText}"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}"
                                    Content="{Binding TypeName}"
                                    Click="TypeButton_Click"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip="{Binding DisabledReason}"
                                    Style="{StaticResource TypeChipButton}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- Bottom-right Refresh button (re-scans families loaded mid-session). -->
        <Button x:Name="RefreshButton"
                Content="Refresh"
                Click="RefreshButton_Click"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Margin="6,0,6,6"
                Style="{StaticResource TypeChipButton}"/>

        <!-- Three stacked panels (not tabs) in a fixed order: Detail Item Tags, Unit / Piece Tags,
             Generic Models — all visible/scrollable at once rather than switched between. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6,6,6,0">
            <StackPanel>

                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="Detail Item Tags" Foreground="{DynamicResource PaletteHeaderText}" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>
                <StackPanel Margin="2,0,2,16">
                    <TextBlock x:Name="DetailItemsPlaceholder"
                               Text="No Detail Item Tag families found in this project."
                               Foreground="{DynamicResource PaletteMutedText}"
                               FontStyle="Italic" FontSize="11" TextWrapping="Wrap"
                               Visibility="Visible"/>
                    <ItemsControl x:Name="DetailItemsList" ItemTemplate="{StaticResource FamilyGroupTemplate}"/>
                </StackPanel>

                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="Unit / Piece Tags" Foreground="{DynamicResource PaletteHeaderText}" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>
                <StackPanel Margin="2,0,2,16">
                    <TextBlock x:Name="UnitPiecesPlaceholder"
                               Text="No unit/piece tag families found in this project."
                               Foreground="{DynamicResource PaletteMutedText}"
                               FontStyle="Italic" FontSize="11" TextWrapping="Wrap"
                               Visibility="Visible"/>
                    <ItemsControl x:Name="UnitPiecesList" ItemTemplate="{StaticResource FamilyGroupTemplate}"/>
                </StackPanel>

                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="Generic Model Tags" Foreground="{DynamicResource PaletteHeaderText}" FontWeight="SemiBold" FontSize="11.5"/>
                </Border>
                <StackPanel Margin="2,0,2,4">
                    <TextBlock x:Name="GenericModelsPlaceholder"
                               Text="No Generic Model Tag families found in this project."
                               Foreground="{DynamicResource PaletteMutedText}"
                               FontStyle="Italic" FontSize="11" TextWrapping="Wrap"
                               Visibility="Visible"/>
                    <ItemsControl x:Name="GenericModelsList" ItemTemplate="{StaticResource FamilyGroupTemplate}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
