<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="GMS.Tools.DetailItemPalette.DetailItemPalettePane"
             Background="{DynamicResource PaletteBg}" FontFamily="Segoe UI Variable Text, Segoe UI" MinWidth="180" d:DesignHeight="184.606">

    <UserControl.Resources>
        <!-- Theme brushes — Color properties are swapped at runtime by ApplyTheme(); defaults are the
             light-theme gray values so the pane isn't off-palette before the first ApplyTheme. -->
        <SolidColorBrush x:Key="PaletteBg"         Color="#f9fafb"/>
        <SolidColorBrush x:Key="PaletteHeaderBg"   Color="#e5e8eb"/>
        <SolidColorBrush x:Key="PaletteHeaderText" Color="#111b27"/>
        <SolidColorBrush x:Key="PaletteSubText"    Color="#374451"/>
        <SolidColorBrush x:Key="PaletteMutedText"  Color="#6f7985"/>
        <SolidColorBrush x:Key="LinkNormal"        Color="#4b5863"/>
        <SolidColorBrush x:Key="LinkHover"         Color="#111b27"/>
        <SolidColorBrush x:Key="LinkPressed"       Color="#030912"/>

        <Style x:Key="LinkButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkNormal}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <TextBlock x:Name="tb"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="12"
                                   Padding="0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="tb" Property="Foreground" Value="{DynamicResource LinkHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tb" Property="Foreground" Value="{DynamicResource LinkPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PaletteHeaderBg}" Padding="8,5"
                CornerRadius="8" Margin="6,6,6,0">
            <TextBlock x:Name="HeaderLabel"
                       Text="Select a detail item"
                       Foreground="{DynamicResource PaletteHeaderText}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Sub-header: sheet count or status -->
        <TextBlock x:Name="SubHeaderLabel"
                   DockPanel.Dock="Top"
                   Margin="8,6,8,0"
                   FontSize="11"
                   Foreground="{DynamicResource PaletteSubText}"
                   TextWrapping="Wrap"/>

        <!-- Placeholder shown when no detail item is selected -->
        <TextBlock x:Name="PlaceholderText"
                   DockPanel.Dock="Top"
                   Text="No detail item selected."
                   Foreground="{DynamicResource PaletteMutedText}"
                   FontStyle="Italic"
                   FontSize="11"
                   Margin="8,6,8,0"
                   Visibility="Visible"/>

        <!-- Scrollable list of sheet hyperlinks -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <ItemsControl x:Name="SheetList" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Click="SheetButton_Click"
                                Style="{StaticResource LinkButton}"
                                Content="{Binding DisplayName}"
                                Margin="0,3,0,0"
                                HorizontalAlignment="Left"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
